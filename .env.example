EMBY_PROJECT_NAME=emby-server-dev
EMBY_VOLUME_ROOT=/root/projects/volumes/emby-server-dev
EMBY_PROXY_ALIAS=emby-server-dev
EMBY_PAGES_ALIAS=emby-pages-dev
EMBY_LOOPBACK_PORT=8097
EMBY_UID=1000
EMBY_GID=1000
EMBY_GIDLIST=1000
TZ=America/Sao_Paulo
RCLONE_REMOTE=gdrive:
RCLONE_DRIVE_ROOT_FOLDER_ID=replace-with-drive-folder-id
RCLONE_CONFIG_DIR=/root/projects/envs/emby-server/dev/secrets
RCLONE_CACHE_MAX_SIZE=2G
